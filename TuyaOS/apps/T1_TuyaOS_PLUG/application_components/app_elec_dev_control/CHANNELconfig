if (ENABLE_TY_LOAD_OEM_PAR=y)
menu "elec channel configuration"
#################### 通道上电模式配置 ####################
config ELEC_CHANNEL_POWER_ON_MODE
    int
    prompt "Power-on mode selection"
    range 0 2
    default 2
    help
    0：上电各通道保持断电状态；1：上电各个通道保持通电状态；2：上电各个通道保持断电前状态

config ELEC_CHANNEL_POWER_ON_DPID
    int
    prompt "Power-on mode dp id"
    range 1 999
    default 38
    help
    断电记忆 DP ID

#################### 通道配置 ####################
config ELEC_CHANNEL_NUM
    int
    prompt "channel number"
    range 1 8
    default 8
    help
    通道个数

#################### 通道 1 配置 ####################
menuconfig ENABLE_ELEC_CHANNEL_1
    bool
    prompt "channel 1 config"
    default y
    depends on (ELEC_CHANNEL_NUM>=1)

    config ELEC_CHANNEL_1_SWITCH_DPID
        int
        prompt "switch dpid"
        range 0 999
        default 1
        depends on (ENABLE_ELEC_CHANNEL_1=y)
        help
        开关 DP

    config ELEC_CHANNEL_1_RELAY_NAME
        string
        prompt "relay name"
        default "relay_1"
        depends on (ENABLE_ELEC_CHANNEL_1=y)
        help
        继电器设备名称
    config ELEC_CHANNEL_1_RELAY_TYPE
        int
        prompt "relay type"
        range 0 1
        default 0
        depends on (ENABLE_ELEC_CHANNEL_1=y)
        help
        继电器类型， 0 ：电保持继电器， 1 ：磁保持继电器

    if (ENABLE_ELEC_CHANNEL_1=y && ELEC_CHANNEL_1_RELAY_TYPE=0)
        config ELEC_CHANNEL_1_RELAY_PIN
            int
            prompt "elec relay pin"
            range 0 999
            default 23
            help
            电保持继电器控制引脚
        config ELEC_CHANNEL_1_RELAY_PIN_MODE
            int
            prompt "elec pin mode"
            range 0 6
            default 4
            help
            4 ：推挽模式（ TUYA_GPIO_PUSH_PULL ）；5 ：开漏输出模式（ TUYA_GPIO_OPENDRAIN ）；6 ：开漏输出上拉模式（ TUYA_GPIO_OPENDRAIN_PULLUP ）
        config ELEC_CHANNEL_1_RELAY_LEVEL
            int
            prompt "elec relay valid level"
            range 0 1
            default 1
            help
            电保持继电器导通电平
    endif

    if (ENABLE_ELEC_CHANNEL_1=y && ELEC_CHANNEL_1_RELAY_TYPE=1)
        config ELEC_CHANNEL_1_RELAY_ON_PIN
            int
            prompt "mag relay on pin"
            range 0 999
            default 24
            help
            磁保持继电器 on_pin ，更多信息查看 tdd_relay_mag.h 文件
        config ELEC_CHANNEL_1_RELAY_OFF_PIN
            int
            prompt "mag relay off pin"
            range 0 999
            default 26
            help
            磁保持继电器 off_pin ，更多信息查看 tdd_relay_mag.h 文件
        config ELEC_CHANNEL_1_RELAY_PIN_MODE
            int
            prompt "elec pin mode"
            range 0 6
            default 4
            help
            4 ：推挽模式（ TUYA_GPIO_PUSH_PULL ）；5 ：开漏输出模式（ TUYA_GPIO_OPENDRAIN ）；6 ：开漏输出上拉模式（ TUYA_GPIO_OPENDRAIN_PULLUP ）
        config ELEC_CHANNEL_1_RELAY_NORMAL_LEVEL
            int
            prompt "mag relay normal level"
            range 0 1
            default 0
            help
            磁保持继电器平常状态下电平值
        config ELEC_CHANNEL_1_RELAY_HOLD_MS
            int
            prompt "mag relay hold time(ms)"
            range 1 500
            default 40
            help
            磁保持继电器动作时，电平保持时间，单位： ms
    endif

    menuconfig ENABLE_ELEC_CHANNEL_1_LED
        bool
        prompt "channel led config"
        default y
        depends on (ENABLE_ELEC_CHANNEL_1=y)

        if (ENABLE_ELEC_CHANNEL_1_LED=y)
            config ELEC_CHANNEL_1_LED_NAME
                string
                prompt "led name"
                default "led_1"
                help
                通道指示灯名称
            config ELEC_CHANNEL_1_LED_PIN
                int
                prompt "led pin"
                range 0 999
                default 26
                help
                通道指示灯名称
            config ELEC_CHANNEL_1_LED_MODE
                int
                prompt "led pin mode"
                range 0 6
                default 4
                help
                4 ：推挽模式（ TUYA_GPIO_PUSH_PULL ）；5 ：开漏输出模式（ TUYA_GPIO_OPENDRAIN ）；6 ：开漏输出上拉模式（ TUYA_GPIO_OPENDRAIN_PULLUP ）
            config ELEC_CHANNEL_1_LED_LEVEL
                int
                prompt "led valid level"
                range 0 1
                default 1
                help
                led 开启电平
        endif

