#################### 按键 0 配置 ####################
menuconfig ENABLE_ELEC_BUTTON_0
    bool
    prompt "button 0 config"
    default y
    depends on (ELEC_BUTTON_NUM>=1)

if (ENABLE_ELEC_BUTTON_0=y)
    config ELEC_BUTTON_0_NAME
        string
        prompt "button name"
        default "button_0"
        help
        按键设备名称

    config ELEC_BUTTON_0_PIN
        int
        prompt "button pin"
        range 0 999
        default 24
        help
        按键设备引脚配置

    config ELEC_BUTTON_0_ACTIVE_LEVEL
        int
        prompt "button active level"
        range 0 1
        default 0
        help
        按键有效触发电平

    config ELEC_BUTTON_0_DEBOUNCE_MS
        int
        prompt "button debounce time(ms)"
        range 1 500
        default 50
        help
        按键消抖时间，单位： ms

    config ELEC_BUTTON_0_LONG_START_MS
        int
        prompt "button long press time(ms)"
        range 0 10000
        default 3000
        help
        按键长按开始触发时间，单位： ms

    config ELEC_BUTTON_0_LONG_KEEP_MS
        int
        prompt "button hold press time(ms)"
        range 200 3000
        default 1000
        help
        按键长按触发之后每隔 n(ms) 执行一次

    config ELEC_BUTTON_0_REPEAT_COUNT
        int
        prompt "button repeat click count"
        range 0 16
        default 4
        help
        按键连击有效次数，达到连击次数后执行对应功能

    config ELEC_BUTTON_0_REPEAT_MS
        int
        prompt "button repeat click interal time(ms)"
        range 0 2000
        default 500
        help
        按键连击有效间隔时间(ms),连击中间停顿的有效时间,超过时间重新记录连击次数

    ###### 按键功能配置 #####

    config ELEC_BUTTON_0_SINGLE_CLICK
        int
        prompt "button single click function"
        range 0 12
        default 0
        help
        短按执行功能: 0.无功能; 1.总控开关； 2.通道 1 状态反转； 3.通道 2 状态反转； 4.通道 3 状态反转； 5.通道 4 状态反转； 6.通道 5 状态反转； 7.通道 6 状态反转； 8.通道 7 状态反转； 9.通道 8 状态反转

