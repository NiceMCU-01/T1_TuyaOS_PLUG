        range 0 12
        default 0
        help
        双击执行功能: 0.无功能;

    config ELEC_BUTTON_0_LONG_PRESS
        int
        prompt "button long press function"
        range 0 12
        default 10
        help
        长按执行功能: 0.无功能; 10. 本地移除设备

    config ELEC_BUTTON_0_REPEAT_CLICK
        int
        prompt "button repeat click function"
