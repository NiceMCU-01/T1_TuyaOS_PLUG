    prompt "real-time power DPID"
    range 1 255
    default 19
    help
    当前功率值的 DPID

config ENERGY_MONITOR_CUR_VOLTAGE_DPID
    int
    prompt "real-time voltage DPID"
    range 1 255
    default 20
    help
    当前电压值的 DPID

config ENERGY_MONITOR_TEST_RESULT_DPID
    int
    prompt "energy monitor calibration results DPID"
    range 1 255
    default 21
    help
    电量统计校准结果的 DPID

config ENERGY_MONITOR_COE_VOLTAGE_DPID
